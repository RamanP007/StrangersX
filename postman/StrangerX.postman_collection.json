              "raw": "{\n  \"username\": \"CoolName_22\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/username",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "username"]
            },
            "description": "Updates the user's username (validated + uniqueness checked) and sets `usernameConfirmed: true`. Registered users only.\n\n**Body**\n- `username` (string, required) — 3–20 chars, letters/numbers/underscore."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
                "body": { "mode": "raw", "raw": "{\n  \"username\": \"CoolName_22\"\n}" },
