            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportedSocketId\": \"b3f1a2c4-...\",\n  \"reason\": \"Explicit or inappropriate content\",\n  \"note\": \"Optional details about what happened.\",\n  \"roomId\": \"room-1719503200\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
