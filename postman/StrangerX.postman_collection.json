              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/api/online", "host": ["{{baseUrl}}"], "path": ["api", "online"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"count\": 1234\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) {",
                  "    pm.collectionVariables.set('jwtToken', data.token);",
                  "    console.log('Saved jwtToken');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN_HERE\",\n  \"termsAccepted\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Verifies a Google ID token, upserts the user in MongoDB, and returns a signed JWT.\n\nNew users are created with a random unique `username` and `usernameConfirmed: false` / `termsAndConditionAccepted: false`.\n\n**Body**\n- `idToken` (string, required) — the Google ID token from the frontend OAuth flow.\n- `termsAccepted` (bool) — legacy flag (no longer gates login; in-app T&C is tracked separately).\n\nThe test script stores `token` into the `jwtToken` collection variable."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"eyJhbGciOiJSUzI1NiIs...\",\n  \"termsAccepted\": true\n}" },
                "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"66a1f0c3e1b2a3d4e5f60718\",\n    \"googleId\": \"108512345678901234567\",\n    \"email\": \"jane@example.com\",\n    \"name\": \"Jane Doe\",\n    \"avatar\": \"https://lh3.googleusercontent.com/a/ACg8ocK...\",\n    \"username\": \"CrimsonViper742\",\n    \"usernameConfirmed\": false,\n    \"termsAccepted\": true,\n    \"termsAcceptedAt\": \"2026-06-27T16:00:00Z\",\n    \"termsAndConditionAccepted\": false,\n    \"termsAndConditionAcceptedAt\": null,\n    \"createdAt\": \"2026-06-27T16:00:00Z\",\n    \"reportCount\": 0\n  }\n}"
            },
            {
              "name": "400 Bad Request (missing idToken)",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{}" },
                "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"error\": \"idToken is required\"\n}"
            },
            {
              "name": "401 Unauthorized (invalid token)",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"invalid\",\n  \"termsAccepted\": true\n}" },
                "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"error\": \"invalid Google token\"\n}"
            }
          ]
        },
        {
          "name": "Create Guest Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.guestToken) {",
                  "    pm.collectionVariables.set('guestToken', data.guestToken);",
                  "    console.log('Saved guestToken');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/guest/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guest", "session"]
            },
            "description": "Creates an anonymous guest session. Returns a UUID stored in Redis with a 24h TTL. Use it as the `X-Guest-Token` header on guest-accessible endpoints (e.g. Submit Report).\n\nThe test script stores `guestToken` into the collection variable."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": { "raw": "{{baseUrl}}/api/guest/session", "host": ["{{baseUrl}}"], "path": ["api", "guest", "session"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"guestToken\": \"2db0230b-4e16-4cbb-84a3-87dcb586f68a\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Account (protected)",
      "item": [
