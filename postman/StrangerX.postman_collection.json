              "body": "{\n  \"user\": {\n    \"id\": \"66a1f0c3e1b2a3d4e5f60718\",\n    \"username\": \"CoolName_22\",\n    \"usernameConfirmed\": true,\n    \"email\": \"jane@example.com\",\n    \"name\": \"Jane Doe\",\n    \"avatar\": \"https://lh3.googleusercontent.com/a/ACg8ocK...\",\n    \"termsAndConditionAccepted\": true,\n    \"createdAt\": \"2026-06-27T16:00:00Z\",\n    \"reportCount\": 0\n  }\n}"
