# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=
NEXTAUTH_SECRET=

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
# Public site URL — used for SEO (canonical, Open Graph, sitemap, robots).
# Set to your real domain in production, e.g. https://strangerx.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=8080

# NOTE: MONGO_URI and REDIS_ADDR are set automatically via docker-compose
# using service names (mongo:27017, redis:6379). Only set these if running
# the backend outside Docker.
# MONGO_URI=mongodb://localhost:27017/omegle
# REDIS_ADDR=localhost:6379
