# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=
NEXTAUTH_SECRET=

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
# Public site URL — used for SEO (canonical, Open Graph, sitemap, robots).
# Set to your real domain in production, e.g. https://strangerx.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=8080

# ─── Admin dashboard (http://localhost:3001) ──────────────────────────────────
# Credentials for the admin panel login. Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Origins allowed to call the API and open WebSockets (comma-separated).
# Must include your deployed frontend's PUBLIC https origin (no trailing slash).
# Defaults to localhost for dev. Use "*" to allow all (less secure).
CORS_ORIGINS=http://localhost:3000
# Example for production:
# CORS_ORIGINS=https://distinguished-playfulness-production-645c.up.railway.app

# ─── Database & Cache ─────────────────────────────────────────────────────────
# Keep these defaults to use the bundled Docker mongo/redis services.
# For hosted databases (MongoDB Atlas, Railway, Upstash, Redis Cloud, …),
# paste your connection strings here instead.
MONGO_URI=mongodb://mongo:27017/dbname
REDIS_URI=redis://redis:6379

# Examples for hosted services:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/omegle?retryWrites=true&w=majority
# REDIS_URI=rediss://default:PASSWORD@host.upstash.io:6379
